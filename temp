
pub fn q_greatest_lower_common_divisor_multiple(

) -> Quiz {
    const SENTENCES: [&str; 3] = [
        "Trouve le {gcd_or_lcm} entre {l}{n1}{l} et {l}{n2}{l}.",
        "Calcule le {gcd_or_lcm} des nombres {l}{n1}{l} et {l}{n2}{l}.",
        "Quel est le {gcd_or_lcm} de {l}{n1}{l} et {l}{n2}{l} ?",
    ];

    let mut rng = rand::rng();

    let lcd_or_gcd: bool = rng.random();

    let (label, op): (&str, fn(i32, i32) -> i32) = if lcd_or_gcd {
        (
            ["plus grand diviseur commun", "PGCD"].choose(&mut rng).unwrap(),
            tools::tools::gcd,
        )
    } else {
        (
            ["plus petit multiple commun", "PPCM"].choose(&mut rng).unwrap(),
            tools::tools::lcm,
        )
    };

    let k = rng.random_range(2..=6);

    let n1 = rng.random_range(interval.0 / k..=interval.1 / k);
    let n2 = generate_number_without_value(
        (interval.0 / k, interval.1 / k),
        Some(n1),
    );

    let answer = op(n1, n2);
    let mut values = vec![answer];

    let mut count = 0;
    while values.len() < 4 {
        count += 1;

        let fake_n1 = rng.gen_range(interval.0 / k..=interval.1 / k);
        let fake_n2 = generate_number_without_value(
            (interval.0 / k, interval.1 / k),
            Some(fake_n1),
        );

        let fake_value = op(fake_n1, fake_n2);

        if !values.contains(&fake_value) {
            values.push(fake_value);
        } else if count > 10 {
            let min_v = *values.iter().min().unwrap();
            let max_v = *values.iter().max().unwrap() + 4;
            values.push(generate_number_without_value((min_v, max_v), None));
        }
    }

    shuffle_vec(&mut values);

    let l = if latex { "$" } else { "" };
    let question = sentences
        .choose(&mut rng)
        .unwrap()
        .replace("{gcd_or_lcm}", label)
        .replace("{n1}", &n1.to_string())
        .replace("{n2}", &n2.to_string())
        .replace("{l}", l);

    Quiz {
        question,
        index_answer: values.iter().position(|&v| v == answer).unwrap(),
        suggested_answer: values
            .into_iter()
            .map(|v| v.to_string())
            .collect(),
    }
}


pub mod tools {
    use rand::Rng;
    use rand::seq::SliceRandom;

    pub fn decomp_factors(n: i32) -> Vec<i32> {
        let mut factors: Vec<i32> = Vec::new();

        if n == 0 {
            return factors;
        } else if n < 0 {
            factors.push(-1);
        }
        let mut n = n.abs();
        while n % 2 == 0 {
            factors.push(2);
            n = n / 2;
        }
        let mut d = 3;
        while d * d <= n {
            while n % d == 0 {
                factors.push(d);
                n = n / d;
            }
            d = d + 2;
        }
        if n > 1 {
            factors.push(n);
        }
        factors
    }

    pub fn is_prime(n: i32) -> bool {
        if n <= 1 { return false; }
        for i in 2..=((n as f64).sqrt().floor() as i32) {
            if n % i == 0 {
                return false;
            }
        }
        true
    }

    pub fn gcd(n: i32, m: i32) -> i32 {
        let mut n = n;
        let mut m = m;

        while m != 0 {
            let r = n % m;
            n = m;
            m = r;
        }
        n
    }

    pub fn lcm(n: i32, m: i32) -> i32 {
        (n / gcd(n, m)) * m
    }

    pub fn shuffle_vec<T>(v: &mut Vec<T>) {
        let mut rng = rand::rng();
        v.shuffle(&mut rng);
    }

    pub fn random_number(min: i32, max: i32, forbidden_values: &[i32]) -> i32 {
        let mut count: u16 = 0;
        let mut value: i32 = rand::rng().random_range(min..=max);
        while count < 65535 && forbidden_values.contains(&value) {
            count += 1;
            value = rand::rng().random_range(min..=max);
        }
        value
    }
}
